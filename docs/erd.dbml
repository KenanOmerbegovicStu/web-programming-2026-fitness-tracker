Table users {
  id int [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(100) [not null]
  fitness_goal varchar(50)
  experience_level varchar(20)
  role varchar(20) [not null, default: 'user', note: 'admin | user']
  created_at datetime
  updated_at datetime
}

Table workouts {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  workout_date date [not null]
  workout_type varchar(50) [not null]
  duration_minutes int
  calories int
  notes text
  created_at datetime
}

Table exercise_categories {
  id int [pk, increment]
  category_name varchar(50) [not null, unique]
  description text
  created_at datetime
}

Table exercises {
  id int [pk, increment]
  category_id int [not null, ref: > exercise_categories.id]
  exercise_name varchar(100) [not null]
  muscle_group varchar(50)
  description text
  created_at datetime
}

Table workout_exercises {
  id int [pk, increment]
  workout_id int [not null, ref: > workouts.id]
  exercise_id int [not null, ref: > exercises.id]
  sets int [not null]
  reps int [not null]
  weight_kg decimal(5,2)
  notes text
}

Table personal_records {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  exercise_id int [not null, ref: > exercises.id]
  max_weight_kg decimal(5,2) [not null]
  reps_achieved int [not null]
  achieved_date date [not null]
  notes text
  created_at datetime
}
